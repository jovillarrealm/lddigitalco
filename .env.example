# LDDIGITALCO — Variables de Entorno y Configuración

# Criptografía y Seguridad de Sesión (Obligatorio en producción)
# Clave secreta para firmar tokens HMAC-SHA256 de Magic Links (mínimo 32 caracteres)
AUTH_SECRET=lddigitalco-secret-key-32-chars-minimum-dev

# Clave Secreta de Administración (Control Center /admin y API de Gestión)
# Por defecto en desarrollo: dev-admin-secret
ADMIN_KEY=dev-admin-secret

# Servicio de Correo Transaccional (Resend)
# Si no se define, el sistema usa FakeEmailService automáticamente (ideal para desarrollo y pruebas)
RESEND_API_KEY=re_123456789_abcdefg

# Notificaciones de Tutoría («Tengo una Duda»)
# Correo del tutor al que se despachan las preguntas de los estudiantes
TUTOR_EMAIL=tutor@lddigital.co

# URL Pública de la Aplicación
APP_URL=http://localhost:4321

# Cloudflare D1 Database (En producción Cloudflare Pages)
# Binding configurado en Cloudflare Pages como: DB
# En desarrollo local se utiliza automáticamente node:sqlite en memoria sin configuración adicional.
