---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="LDDIGITALCO — Ecosistema Digital & Consultoría Estratégica" activeNav="inicio">
  <!-- UNIFIED HERO SECTION -->
  <section id="hero" class="relative pt-20 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full text-center overflow-hidden">
    
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-gradient-to-tr from-cyan-600/15 via-emerald-600/10 to-transparent blur-3xl -z-10 pointer-events-none"></div>

    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-900 border border-slate-700/80 text-slate-300 text-xs font-semibold mb-8 shadow-inner">
      <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
      Ecosistema Integral de Transformación Digital & Capacitación
    </div>

    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold font-tech text-white tracking-tight leading-[1.1] max-w-4xl mx-auto mb-6">
      Impulsamos su Negocio y Acercamos la <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-300 to-emerald-400">Tecnología a Cada Etapa</span>
    </h1>

    <p class="text-slate-300 text-lg sm:text-xl max-w-3xl mx-auto mb-10 leading-relaxed font-normal">
      Desde la automatización con IA y posicionamiento para empresas y marcas personales, hasta programas cálidos de ciberseguridad y habilidades digitales para personas mayores.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <a href="#pilares" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold text-sm shadow-lg shadow-cyan-500/25 transition-all transform hover:-translate-y-0.5 flex items-center justify-center gap-2">
        <span>Conocer los 4 Pilares</span>
        <span class="text-base">↓</span>
      </a>
      <a href="/alumnos" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold text-sm border border-slate-700 transition-all flex items-center justify-center gap-2">
        <span>Probar el Portal del Estudiante</span>
        <span class="text-emerald-400">▶</span>
      </a>
    </div>

    <!-- Trust Stats Bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto pt-8 border-t border-slate-800/80 text-left">
      <div class="p-3">
        <span class="block text-2xl lg:text-3xl font-extrabold font-tech text-white">4 Pilares</span>
        <span class="text-xs text-slate-300">Especializados a su medida</span>
      </div>
      <div class="p-3">
        <span class="block text-2xl lg:text-3xl font-extrabold font-tech text-cyan-400">100% Práctico</span>
        <span class="text-xs text-slate-300">Inteligencia Artificial y ventas</span>
      </div>
      <div class="p-3">
        <span class="block text-2xl lg:text-3xl font-extrabold font-tech text-emerald-400">+50 Senior</span>
        <span class="text-xs text-slate-300">Paciencia y ciberseguridad</span>
      </div>
      <div class="p-3">
        <span class="block text-2xl lg:text-3xl font-extrabold font-tech text-teal-300">Híbrido</span>
        <span class="text-xs text-slate-300">Videos cortos + Clases en vivo</span>
      </div>
    </div>

  </section>

  <!-- THE 4 PILLARS UNIFIED GRID -->
  <section id="pilares" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full border-t border-slate-800/60">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold text-cyan-400 uppercase tracking-widest block mb-2 font-tech">Portafolio LDDIGITALCO</span>
      <h2 class="text-3xl sm:text-5xl font-extrabold font-tech text-white tracking-tight">
        Nuestros <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-emerald-400">4 Pilares Estratégicos</span>
      </h2>
      <p class="text-slate-300 text-base mt-4 leading-relaxed">
        Soluciones diseñadas con rigor técnico, enfoque en resultados y una pedagogía empática adaptada a cada necesidad.
      </p>
    </div>

    <!-- 4-Column Responsive Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- CARD 1: ASESORÍA EMPRENDEDORES -->
      <div class="glass-card rounded-2xl p-6 border border-slate-700/80 hover:glow-border-blue transition-all duration-300 flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between mb-5">
            <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
              🚀
            </div>
            <span class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-slate-900 text-cyan-400 border border-cyan-500/30">Pilar 01</span>
          </div>

          <h3 class="text-lg font-bold font-tech text-white mb-2 group-hover:text-cyan-300 transition-colors">
            Asesoría Emprendedores
          </h3>
          <p class="text-slate-300 text-xs leading-relaxed mb-6">
            Orientada a comerciantes, independientes y startups nacientes. Implementamos IA para validar ideas, optimizar atención al cliente y generar primeras ventas digitales.
          </p>

          <div class="space-y-2 text-xs text-slate-300 mb-6 border-t border-slate-800 pt-4">
            <div class="flex items-center gap-2">
              <span class="text-cyan-400 font-bold">✓</span>
              <span>IA para comerciantes y tiendas</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-cyan-400 font-bold">✓</span>
              <span>Automatización de mensajes y ventas</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-cyan-400 font-bold">✓</span>
              <span>Diagnóstico de negocio 1 a 1</span>
            </div>
          </div>
        </div>

        <div class="space-y-2">
          <a href="/b2b#emprendedores" class="w-full py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 text-center block text-xs border border-slate-700 font-medium transition-colors">
            Ver detalles del plan
          </a>
          <button onclick="openBookingModal('Asesoría Emprendedores')" class="w-full py-2.5 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold text-xs shadow-md shadow-cyan-500/20 transition-all flex items-center justify-center gap-1">
            <span>Agendar Diagnóstico</span> →
          </button>
        </div>
      </div>

      <!-- CARD 2: ASESORÍA CORPORATIVA -->
      <div class="glass-card rounded-2xl p-6 border-2 border-cyan-500/50 glow-blue transition-all duration-300 flex flex-col justify-between relative group">
        <div class="absolute -top-3 right-4 px-2.5 py-0.5 rounded-full bg-cyan-400 text-slate-950 font-black text-[9px] uppercase tracking-wider shadow">
          Empresas
        </div>

        <div>
          <div class="flex items-center justify-between mb-5">
            <div class="w-12 h-12 rounded-xl bg-cyan-500/20 border border-cyan-400 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
              🏢
            </div>
            <span class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-slate-900 text-cyan-400 border border-cyan-500/30">Pilar 02</span>
          </div>

          <h3 class="text-lg font-bold font-tech text-white mb-2 group-hover:text-cyan-300 transition-colors">
            Asesoría Corporativa
          </h3>
          <p class="text-slate-200 text-xs leading-relaxed mb-6">
            Para pymes consolidadas y directivos. Reingeniería operativa mediante agentes de Inteligencia Artificial, reducción de costes y capacitación in-company para equipos.
          </p>

          <div class="space-y-2 text-xs text-slate-200 mb-6 border-t border-slate-800 pt-4">
            <div class="flex items-center gap-2">
              <span class="text-cyan-400 font-bold">✓</span>
              <span>Auditoría de procesos corporativos</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-cyan-400 font-bold">✓</span>
              <span>Agentes y flujos automatizados</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-cyan-400 font-bold">✓</span>
              <span>Coaching de liderazgo técnico</span>
            </div>
          </div>
        </div>

        <div class="space-y-2">
          <a href="/b2b#corporativa" class="w-full py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 text-center block text-xs border border-slate-700 font-medium transition-colors">
            Ver detalles del plan
          </a>
          <button onclick="openBookingModal('Asesoría Corporativa')" class="w-full py-2.5 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold text-xs shadow-md shadow-cyan-500/20 transition-all flex items-center justify-center gap-1">
            <span>Solicitar Propuesta</span> →
          </button>
        </div>
      </div>

      <!-- CARD 3: PROGRAMA +50 (SENIOR HIGHLIGHT) -->
      <div class="glass-card rounded-2xl p-6 border-2 border-emerald-400/80 glow-green transition-all duration-300 flex flex-col justify-between relative group bg-gradient-to-b from-[#0a1814] to-slate-900">
        <div class="absolute -top-3 right-4 px-2.5 py-0.5 rounded-full bg-emerald-400 text-slate-950 font-black text-[9px] uppercase tracking-wider shadow">
          Inclusión
        </div>

        <div>
          <div class="flex items-center justify-between mb-5">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/20 border border-emerald-400 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
              🛡️
            </div>
            <span class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-slate-900 text-emerald-400 border border-emerald-500/30">Pilar 03</span>
          </div>

          <h3 class="text-lg font-bold font-tech text-white mb-2 group-hover:text-emerald-300 transition-colors">
            Programa +50
          </h3>
          <p class="text-slate-200 text-xs leading-relaxed mb-6">
            Capacitación cercana para adultos mayores. Domine su celular, computador, ciberseguridad anti-estafas e IA cotidiana con clases en vivo y cápsulas de video de 2 minutos.
          </p>

          <div class="space-y-2 text-xs text-slate-200 mb-6 border-t border-slate-800 pt-4">
            <div class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>Detección de fraudes y estafas</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>Uso fácil de WhatsApp y celular</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>Clases grupales semanales en vivo</span>
            </div>
          </div>
        </div>

        <div class="space-y-2">
          <a href="/senior" class="w-full py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 text-center block text-xs border border-slate-700 font-medium transition-colors">
            Ver Portal Senior (+50)
          </a>
          <button onclick="openBookingModal('Programa +50')" class="w-full py-2.5 rounded-xl bg-emerald-400 hover:bg-emerald-300 text-slate-950 font-bold text-xs shadow-md shadow-emerald-500/20 transition-all flex items-center justify-center gap-1">
            <span>Inscribirme al Programa</span> →
          </button>
        </div>
      </div>

      <!-- CARD 4: PLAN MARCA PERSONAL -->
      <div class="glass-card rounded-2xl p-6 border border-slate-700/80 hover:glow-border-blue transition-all duration-300 flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between mb-5">
            <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
              💎
            </div>
            <span class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-slate-900 text-cyan-400 border border-cyan-500/30">Pilar 04</span>
          </div>

          <h3 class="text-lg font-bold font-tech text-white mb-2 group-hover:text-cyan-300 transition-colors">
            Plan Marca Personal
          </h3>
          <p class="text-slate-300 text-xs leading-relaxed mb-6">
            Especial para líderes, consultores y profesionales que buscan posicionamiento de autoridad. Estrategia de narrativa, visibilidad omnicanal y creación de contenido sistemática con IA.
          </p>

          <div class="space-y-2 text-xs text-slate-300 mb-6 border-t border-slate-800 pt-4">
            <div class="flex items-center gap-2">
              <span class="text-cyan-400 font-bold">✓</span>
              <span>Posicionamiento en LinkedIn e Instagram</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-cyan-400 font-bold">✓</span>
              <span>Sistema de contenido potenciado con IA</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-cyan-400 font-bold">✓</span>
              <span>Mentoría 1 a 1 de marca</span>
            </div>
          </div>
        </div>

        <div class="space-y-2">
          <a href="/b2b#marca-personal" class="w-full py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 text-center block text-xs border border-slate-700 font-medium transition-colors">
            Ver detalles del plan
          </a>
          <button onclick="openBookingModal('Plan Marca Personal')" class="w-full py-2.5 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold text-xs shadow-md shadow-cyan-500/20 transition-all flex items-center justify-center gap-1">
            <span>Construir mi Marca</span> →
          </button>
        </div>
      </div>

    </div>

  </section>

  <!-- HYBRID MODEL SECTION -->
  <section id="modelo-hibrido" class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
    
    <div class="glass-card rounded-3xl p-8 sm:p-12 border border-slate-800 bg-gradient-to-r from-slate-950 via-[#0b1322] to-slate-950">
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        
        <div>
          <span class="px-3 py-1 rounded-full text-xs font-bold bg-teal-500/10 text-teal-300 border border-teal-500/30 uppercase tracking-wider mb-4 inline-block font-tech">
            Metodología Comprobada
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold font-tech text-white mb-4">
            El Poder del <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-emerald-400">Modelo Híbrido</span>
          </h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
            Combinamos lo mejor de dos mundos para garantizar que el conocimiento realmente se aplique, tanto en directivos ocupados como en adultos mayores que requieren acompañamiento:
          </p>

          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-lg shrink-0">
                ⚡
              </div>
              <div>
                <h4 class="font-bold text-white text-sm">Microcápsulas Pregrabadas (El Saber)</h4>
                <p class="text-slate-400 text-xs mt-0.5">Lecciones concretas de 2 a 3 minutos para consultar en cualquier momento, sin relleno ni teoría innecesaria.</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 text-lg shrink-0">
                👥
              </div>
              <div>
                <h4 class="font-bold text-white text-sm">Sesiones en Vivo & Mentoría (El Hacer)</h4>
                <p class="text-slate-400 text-xs mt-0.5">Videollamadas periódicas en directo para resolver dudas exactas, desbloquear obstáculos técnicos y recibir retroalimentación.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-slate-900/90 rounded-2xl p-6 border border-slate-700/80 shadow-2xl space-y-4">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-slate-300">Tu Ruta de Aprendizaje en LDDIGITALCO</span>
            <span class="text-[11px] text-emerald-400 font-mono">100% Guiado</span>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-7 h-7 rounded-lg bg-cyan-500/20 text-cyan-400 flex items-center justify-center text-xs font-bold">1</span>
              <div>
                <span class="text-xs font-bold text-white block">Diagnóstico Inicial</span>
                <span class="text-[11px] text-slate-400">Identificación de objetivos y nivel de partida</span>
              </div>
            </div>
            <span class="text-xs text-cyan-400">Paso 1</span>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-7 h-7 rounded-lg bg-cyan-500/20 text-cyan-400 flex items-center justify-center text-xs font-bold">2</span>
              <div>
                <span class="text-xs font-bold text-white block">Acceso al Portal Privado</span>
                <span class="text-[11px] text-slate-400">Biblioteca de cápsulas paso a paso</span>
              </div>
            </div>
            <span class="text-xs text-cyan-400">Paso 2</span>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-950 border border-emerald-500/30 flex items-center justify-between bg-emerald-950/20">
            <div class="flex items-center gap-3">
              <span class="w-7 h-7 rounded-lg bg-emerald-400 text-slate-950 flex items-center justify-center text-xs font-bold">3</span>
              <div>
                <span class="text-xs font-bold text-white block">Mentoría & Clases en Directo</span>
                <span class="text-[11px] text-emerald-300">Acompañamiento en vivo vía Zoom/Meet</span>
              </div>
            </div>
            <span class="text-xs text-emerald-400 font-bold">Semanal</span>
          </div>
        </div>

      </div>
    </div>

  </section>

  <!-- CTA BANNER -->
  <section class="py-16 px-4 max-w-5xl mx-auto w-full text-center">
    <div class="glass-card rounded-3xl p-10 border border-slate-800 bg-gradient-to-tr from-cyan-950/40 via-slate-900 to-emerald-950/40">
      <h3 class="text-3xl font-extrabold font-tech text-white mb-4">¿Listo para transformar su presencia y habilidades digitales?</h3>
      <p class="text-slate-300 text-sm max-w-xl mx-auto mb-8">
        Hable hoy mismo con nosotros para agendar su diagnóstico estratégico o para solicitar información sobre el Programa +50.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <button onclick="openBookingModal('Asesoría General')" class="px-8 py-3.5 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold text-sm shadow-lg shadow-cyan-500/20">
          Agendar Sesión de 30 min →
        </button>
        <button onclick="openWhatsApp()" class="px-8 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-emerald-300 border border-emerald-500/40 font-bold text-sm flex items-center gap-2">
          <span>Hablar por WhatsApp</span> 💬
        </button>
      </div>
    </div>
  </section>
</BaseLayout>
