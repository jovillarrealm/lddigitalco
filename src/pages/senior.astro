---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Programa +50 — Inclusión Digital & Ciberseguridad | LDDIGITALCO" 
  theme="senior" 
  activeNav="senior"
>
  <!-- Senior Hero -->
  <header class="py-16 px-4 max-w-4xl mx-auto text-center">
    
    <div class="inline-flex items-center gap-2 px-5 py-2 rounded-full bg-emerald-950 border border-emerald-500/50 text-emerald-300 text-sm font-bold mb-6">
      <span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span>
      Aprenda a su ritmo • Sin prisas • Con profesores pacientes
    </div>

    <h1 class="text-4xl sm:text-6xl font-extrabold font-tech text-white mb-6 leading-tight">
      Tecnología y Ciberseguridad <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-green-300">fácil y sin miedo</span>
    </h1>

    <p class="text-slate-200 text-xl leading-relaxed mb-8 max-w-2xl mx-auto">
      Domine el uso de su celular, computador, protéjase de estafas en internet y descubra la Inteligencia Artificial explicada con ejemplos de la vida diaria.
    </p>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10">
      <a href="#registro-ruta-abierta" class="w-full sm:w-auto px-9 py-5 rounded-2xl bg-emerald-400 hover:bg-emerald-300 text-slate-950 font-black text-lg shadow-xl shadow-emerald-500/30 transition-transform transform hover:scale-105 flex items-center justify-center gap-2">
        <span>Inscribirme a la Ruta Abierta</span>
        <span>→</span>
      </a>


      <button onclick="openWhatsApp('Hola, me gustaría saber si este curso es para mí o para mi familiar.')" class="w-full sm:w-auto px-8 py-5 rounded-2xl bg-slate-900 hover:bg-slate-800 text-emerald-300 font-bold text-base border-2 border-emerald-500/40 transition-colors flex items-center justify-center gap-2">
        <span>Preguntar dudas por WhatsApp</span>
        <span>📞</span>
      </button>
    </div>

    <!-- Audience switch badge -->
    <div class="inline-block p-4 rounded-2xl bg-slate-900/90 border border-emerald-900/80 text-sm text-slate-300">
      💡 <strong>¿Eres hijo, nieto o familiar?</strong> Puedes inscribir a tus padres o abuelos y nosotros nos encargamos de guiarlos con paciencia y cariño.
    </div>

  </header>

  <!-- 3 Pillars of Programa +50 -->
  <main id="modulos" class="max-w-6xl mx-auto px-4 pb-20 space-y-16">
    
    <!-- Sección de Auto-registro a la Ruta Abierta (Ticket #6) -->
    <section id="registro-ruta-abierta" class="glass-card rounded-3xl p-8 sm:p-12 border-2 border-emerald-400 glow-green bg-gradient-to-b from-[#0c281e] via-slate-900 to-[#071710] shadow-2xl relative">
      <div class="max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-500/20 border border-emerald-400 text-emerald-300 text-xs font-bold uppercase tracking-wider mb-4">
          <span>🌿</span> Auto-registro Gratuito • Sin Contraseñas • Sin Tarjetas
        </div>

        <h2 class="text-2xl sm:text-4xl font-extrabold font-tech text-white mb-4 leading-tight">
          Empiece hoy mismo con la <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-green-300">Ruta Abierta</span>
        </h2>

        <p class="text-slate-200 text-base sm:text-lg mb-8 leading-relaxed">
          Aprenda a su propio ritmo cómo blindar su WhatsApp contra engaños y configurar su teléfono cómodamente. Sin contraseñas difíciles que memorizar y con explicaciones paso a paso pensadas para usted.
        </p>

        <form id="open-track-form" class="space-y-6" novalidate>
          <div class="grid sm:grid-cols-2 gap-6">
            <div>
              <label for="open-name" class="block text-base sm:text-lg font-bold text-white mb-2">
                Su Nombre <span class="text-emerald-400" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="open-name"
                name="nombre"
                required
                autocomplete="name"
                placeholder="Ej. María o Carlos"
                class="w-full min-h-[54px] text-base sm:text-lg px-5 py-4 rounded-xl bg-slate-900 border-2 border-slate-700 text-white placeholder-slate-300 focus:outline-none focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/20 transition-all"
              />
            </div>

            <div>
              <label for="open-email" class="block text-base sm:text-lg font-bold text-white mb-2">
                Su Correo Electrónico <span class="text-emerald-400" aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="open-email"
                name="email"
                required
                autocomplete="email"
                placeholder="ejemplo@correo.com"
                class="w-full min-h-[54px] text-base sm:text-lg px-5 py-4 rounded-xl bg-slate-900 border-2 border-slate-700 text-white placeholder-slate-300 focus:outline-none focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/20 transition-all"
              />
            </div>
          </div>

          <div id="open-form-feedback" class="hidden" role="status" aria-live="polite"></div>

          <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2">
            <button
              type="submit"
              id="open-submit-btn"
              class="w-full sm:w-auto min-h-[54px] px-8 py-4 rounded-2xl bg-emerald-400 hover:bg-emerald-300 text-slate-950 font-black text-base sm:text-lg shadow-xl shadow-emerald-500/30 transition-transform transform hover:scale-[1.01] flex items-center justify-center gap-3 cursor-pointer"
            >
              <span>📩</span>
              <span id="open-submit-text">Ingresar a la Ruta Abierta en 1 Clic</span>
            </button>

            <span class="text-xs sm:text-sm text-slate-300 flex items-center gap-1.5">
              <span>🔒</span> Sin spam ni contraseñas. Acceso seguro inmediato.
            </span>
          </div>
        </form>
      </div>
    </section>

    <div class="text-center max-w-2xl mx-auto">
      <span class="text-emerald-400 font-bold text-sm uppercase tracking-wider block mb-1">Contenido Completo</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold font-tech text-white">Los Módulos del Programa</h2>
    </div>


    <div class="grid md:grid-cols-3 gap-8">
      
      <!-- Module 1 -->
      <div class="glass-card rounded-3xl p-8 border-2 border-emerald-500/40 bg-gradient-to-b from-[#091e16] to-[#07140f] flex flex-col justify-between shadow-xl">
        <div>
          <div class="w-16 h-16 rounded-2xl bg-emerald-500/20 text-emerald-400 border border-emerald-400 flex items-center justify-center text-3xl mb-6">
            🛡️
          </div>
          <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest block mb-1">Módulo 01</span>
          <h3 class="text-2xl font-bold font-tech text-white mb-3">Ciberseguridad & Anti-Estafas</h3>
          <p class="text-slate-200 text-base leading-relaxed mb-6">
            Aprenda a reconocer mensajes falsos de bancos, llamadas engañosas y enlaces sospechosos para que nunca nadie se aproveche de su confianza.
          </p>
          <ul class="space-y-3 text-base text-slate-200 mb-8 border-t border-emerald-900/60 pt-4 font-medium">
            <li class="flex items-center gap-2"><span class="text-emerald-400 font-black text-lg">✓</span> Claves seguras y cómo recordarlas</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400 font-black text-lg">✓</span> Qué hacer ante un mensaje dudoso</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400 font-black text-lg">✓</span> Operaciones bancarias 100% protegidas</li>
          </ul>
        </div>
        <button onclick="openBookingModal('Programa +50 - Ciberseguridad')" class="w-full py-4 rounded-xl bg-emerald-400 hover:bg-emerald-300 text-slate-950 font-bold text-sm shadow-md shadow-emerald-500/20">
          Inscribirme a este módulo →
        </button>
      </div>

      <!-- Module 2 -->
      <div class="glass-card rounded-3xl p-8 border-2 border-emerald-400 glow-green bg-gradient-to-b from-[#0c281e] to-[#071710] flex flex-col justify-between shadow-2xl relative">
        <div class="absolute -top-3 right-6 px-3 py-1 rounded-full bg-emerald-400 text-slate-950 font-black text-xs uppercase tracking-wider shadow">
          El Más Querido
        </div>
        <div>
          <div class="w-16 h-16 rounded-2xl bg-emerald-400 text-slate-950 flex items-center justify-center text-3xl mb-6 font-bold">
            📱
          </div>
          <span class="text-xs font-bold text-emerald-300 uppercase tracking-widest block mb-1">Módulo 02</span>
          <h3 class="text-2xl font-bold font-tech text-white mb-3">Celular y Computador Fácil</h3>
          <p class="text-slate-100 text-base leading-relaxed mb-6">
            Comuníquese con sus hijos y nietos sin depender de terceros. Envíe audios, fotos, haga videollamadas nítidas y haga trámites desde casa.
          </p>
          <ul class="space-y-3 text-base text-slate-100 mb-8 border-t border-emerald-800 pt-4 font-medium">
            <li class="flex items-center gap-2"><span class="text-emerald-400 font-black text-lg">✓</span> Manejo total de WhatsApp</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400 font-black text-lg">✓</span> Letras grandes y pantalla cómoda</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400 font-black text-lg">✓</span> Videollamadas en Zoom y Meet</li>
          </ul>
        </div>
        <button onclick="openBookingModal('Programa +50 - Celulares')" class="w-full py-4 rounded-xl bg-emerald-400 hover:bg-emerald-300 text-slate-950 font-bold text-sm shadow-lg shadow-emerald-500/30">
          Inscribirme a este módulo →
        </button>
      </div>

      <!-- Module 3 -->
      <div class="glass-card rounded-3xl p-8 border-2 border-emerald-500/40 bg-gradient-to-b from-[#091e16] to-[#07140f] flex flex-col justify-between shadow-xl">
        <div>
          <div class="w-16 h-16 rounded-2xl bg-emerald-500/20 text-emerald-400 border border-emerald-400 flex items-center justify-center text-3xl mb-6">
            🤖
          </div>
          <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest block mb-1">Módulo 03</span>
          <h3 class="text-2xl font-bold font-tech text-white mb-3">Inteligencia Artificial Práctica</h3>
          <p class="text-slate-200 text-base leading-relaxed mb-6">
            Hable con la IA como si fuera un asistente personal. Pídale ideas de cocina, ayuda para redactar cartas, recordatorios de medicinas o historias interesantes.
          </p>
          <ul class="space-y-3 text-base text-slate-200 mb-8 border-t border-emerald-900/60 pt-4 font-medium">
            <li class="flex items-center gap-2"><span class="text-emerald-400 font-black text-lg">✓</span> Asistentes de voz en el celular</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400 font-black text-lg">✓</span> Respuestas claras a dudas de salud</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400 font-black text-lg">✓</span> Ejercicios de memoria y agilidad</li>
          </ul>
        </div>
        <button onclick="openBookingModal('Programa +50 - IA')" class="w-full py-4 rounded-xl bg-emerald-400 hover:bg-emerald-300 text-slate-950 font-bold text-sm shadow-md shadow-emerald-500/20">
          Inscribirme a este módulo →
        </button>
      </div>

    </div>

    <!-- How It Works Section -->
    <section id="como-funciona" class="glass-card rounded-3xl p-10 border border-emerald-900 bg-slate-950/90 mt-16">
      <h3 class="text-2xl sm:text-3xl font-bold font-tech text-white mb-6 text-center">¿Cómo es la Metodología Híbrida del Programa +50?</h3>
      <div class="grid md:grid-cols-2 gap-8 text-base">
        <div class="p-6 rounded-2xl bg-[#091a13] border border-emerald-500/30">
          <div class="text-3xl mb-3">📺</div>
          <h4 class="text-xl font-bold text-emerald-300 mb-2">1. Cápsulas en Video de 2 Minutos</h4>
          <p class="text-slate-300 text-sm leading-relaxed">
            Nada de videos largos ni complicados. Son lecciones cortitas y prácticas con flechas grandes en pantalla para que practique en su propio celular a cualquier hora.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-[#091a13] border border-emerald-500/30">
          <div class="text-3xl mb-3">👥</div>
          <h4 class="text-xl font-bold text-emerald-300 mb-2">2. Clases Grupales en Vivo por Semana</h4>
          <p class="text-slate-300 text-sm leading-relaxed">
            Nos reunimos todos los miércoles por videollamada para repasar juntos, hacer preguntas y resolver en directo cualquier problema que tenga en su teléfono o computador.
          </p>
        </div>
      </div>
      <div class="mt-8 text-center">
        <a href="/alumnos" class="inline-flex items-center gap-2 px-8 py-4 rounded-2xl bg-emerald-400 hover:bg-emerald-300 text-slate-950 font-bold text-base shadow-lg shadow-emerald-500/20">
          <span>Ver cómo es la pantalla del estudiante</span> ▶
        </a>
      </div>
    </section>

  </main>

  <script is:inline>
    // Client-side handling for Open Track registration form (Issue #6)
    const openForm = document.getElementById('open-track-form');
    if (openForm) {
      openForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const nameInput = document.getElementById('open-name');
        const emailInput = document.getElementById('open-email');
        const feedback = document.getElementById('open-form-feedback');
        const submitBtn = document.getElementById('open-submit-btn');
        const submitText = document.getElementById('open-submit-text');

        const nombre = nameInput?.value?.trim();
        const email = emailInput?.value?.trim();

        if (!email) {
          if (feedback) {
            feedback.className = 'p-4 rounded-xl bg-red-950/80 border border-red-500 text-red-200 text-sm font-medium';
            feedback.innerHTML = '⚠️ Por favor, escriba su correo electrónico.';
          }
          return;
        }

        if (submitBtn) submitBtn.disabled = true;
        if (submitText) submitText.textContent = 'Enviando su enlace de acceso...';
        if (feedback) {
          feedback.className = 'hidden';
          feedback.innerHTML = '';
        }

        try {
          const res = await fetch('/api/auth/register-open-track', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, nombre }),
          });

          const data = await res.json();

          if (res.ok && data.success) {
            if (feedback) {
              feedback.className = 'p-6 rounded-2xl bg-emerald-950/90 border-2 border-emerald-400 text-white text-base leading-relaxed';
              feedback.innerHTML = `
                <div class="flex items-start gap-4">
                  <span class="text-3xl">🎉</span>
                  <div>
                    <strong class="text-emerald-300 block text-lg mb-1 font-bold">¡Bienvenido a la Ruta Abierta!</strong>
                    <p class="text-slate-100">
                      Te enviamos tu enlace de acceso a tu correo. Revisa tu bandeja de entrada para ingresar sin contraseña.
                    </p>
                  </div>
                </div>
              `;
            }
            if (openForm) openForm.reset();
            if (submitText) submitText.textContent = 'Reenviar Enlace de Acceso';
          } else {
            if (feedback) {
              feedback.className = 'p-4 rounded-xl bg-amber-950/80 border border-amber-500 text-amber-200 text-sm font-medium';
              feedback.innerHTML = `⚠️ ${data.error || 'No se pudo procesar el registro. Intente nuevamente.'}`;
            }
            if (submitText) submitText.textContent = 'Ingresar a la Ruta Abierta en 1 Clic';
          }
        } catch (err) {
          if (feedback) {
            feedback.className = 'p-4 rounded-xl bg-red-950/80 border border-red-500 text-red-200 text-sm font-medium';
            feedback.innerHTML = '⚠️ Ocurrió un error de conexión al enviar el enlace. Verifique su internet e intente nuevamente.';
          }
          if (submitText) submitText.textContent = 'Ingresar a la Ruta Abierta en 1 Clic';
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    }
  </script>
</BaseLayout>

