---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAuthServiceFromContext, getDbFromContext, hasFullAccess } from '../lib/auth';
import { getRouteBySlug, calculateRouteProgress } from '../lib/courses';
import { getProgressByStudent } from '../lib/db/progreso';
import { getStudentById } from '../lib/db/estudiantes';
import { getUpcomingLiveSession } from '../lib/courses/live-session';

const authService = getAuthServiceFromContext(Astro);
const sessionStudent = await authService.getSessionFromRequest(Astro.request);

const loginSuccess = Astro.url.searchParams.get('login') === 'success';
const authError = Astro.url.searchParams.get('error');

let student: any = null;
let isEnrolledFull = false;
let route: any = null;
let completedSlugs: string[] = [];
let progressStats = { total: 0, completadas: 0, porcentaje: 0 };
let currentCapsule: any = null;
let routeAccessBlocked = false;
const liveSessionInfo = getUpcomingLiveSession();

if (sessionStudent) {
  const db = getDbFromContext(Astro);
  const freshStudent = await getStudentById(db, sessionStudent.id);
  student = freshStudent || sessionStudent;
  isEnrolledFull = hasFullAccess(student);

  const routeSlug = Astro.url.searchParams.get('ruta') || 'ciberseguridad-whatsapp';
  const targetRoute = getRouteBySlug(routeSlug) || getRouteBySlug('ciberseguridad-whatsapp')!;

  if (targetRoute.nivel === 'inscripcion_completa' && !isEnrolledFull) {
    routeAccessBlocked = true;
    route = getRouteBySlug('ciberseguridad-whatsapp')!;
  } else {
    route = targetRoute;
  }

  const progressRecords = await getProgressByStudent(db, student.id);
  completedSlugs = progressRecords.map((p) => p.microcapsula_slug);
  progressStats = calculateRouteProgress(completedSlugs, route);

  const firstUnfinishedIdx = route.microcapsulas.findIndex((c: any) => !completedSlugs.includes(c.slug));
  const activeIdx = firstUnfinishedIdx !== -1 ? firstUnfinishedIdx : 0;
  currentCapsule = route.microcapsulas[activeIdx];
}

---

<BaseLayout title="Portal del Estudiante — LDDIGITALCO" activeNav="alumnos">
  <!-- LMS Main Area -->
  <main class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 flex-1">
    
    {loginSuccess && (
      <div role="alert" class="mb-6 p-4 rounded-2xl bg-emerald-950/80 border-2 border-emerald-400 text-white flex items-center gap-3">
        <span class="text-2xl">🎉</span>
        <div>
          <h3 class="font-bold text-emerald-300">¡Acceso concedido!</h3>
          <p class="text-sm text-slate-200">Su sesión está activa. Bienvenido a su Aula Digital.</p>
        </div>
      </div>
    )}

    {authError && (
      <div role="alert" class="mb-6 p-4 rounded-2xl bg-amber-950/80 border-2 border-amber-400 text-white flex items-center gap-3">
        <span class="text-2xl">⚠️</span>
        <div>
          <h3 class="font-bold text-amber-300">Enlace no válido o expirado</h3>
          <p class="text-sm text-slate-200">El enlace de acceso ya no es válido o pasaron más de 15 minutos. Ingrese su correo abajo para recibir uno nuevo.</p>
        </div>
      </div>
    )}

    {routeAccessBlocked && (
      <div role="alert" class="mb-6 p-5 rounded-2xl bg-cyan-950/80 border-2 border-cyan-400 text-white flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="text-3xl">🔒</span>
          <div>
            <h3 class="font-bold text-cyan-300">Ruta protegida para Inscripción Completa</h3>
            <p class="text-sm text-slate-200">
              La ruta solicitada requiere Inscripción Completa. Mientras tanto, puede seguir aprendiendo en su <strong>Ruta Abierta</strong> sin interrupciones.
            </p>
          </div>
        </div>
        <a
          href="https://wa.me/573000000000?text=Hola,%20quisiera%20solicitar%20la%20Inscripción%20Completa%20para%20desbloquear%20todas%20las%20rutas."
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 px-4 py-2.5 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold text-xs shadow-md transition-colors"
        >
          Mejorar mi Acceso
        </a>
      </div>
    )}


    {!student && (
      <section aria-labelledby="login-heading" class="max-w-2xl mx-auto my-8">
        <div class="glass-card rounded-3xl p-8 sm:p-12 border-2 border-slate-700 shadow-2xl relative overflow-hidden">
          
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/80 border border-cyan-500/40 text-cyan-300 text-xs font-bold uppercase tracking-wider mb-6">
            <span>🛡️</span> Acceso sin Contraseña
          </div>

          <h1 id="login-heading" class="text-2xl sm:text-3xl font-bold font-tech text-white mb-4 leading-tight">
            Bienvenido a su Aula Digital
          </h1>

          <p class="text-slate-200 text-base sm:text-lg mb-8 leading-relaxed">
            En <strong>LDDIGITALCO</strong> no necesita memorizar contraseñas difíciles. Escriba su correo electrónico y le enviaremos un enlace seguro para entrar en <strong>1 solo clic</strong>.
          </p>

          <form id="magic-link-form" class="space-y-6" novalidate>
            <div>
              <label for="student-email" class="block text-base font-semibold text-white mb-2">
                Su Correo Electrónico <span class="text-emerald-400" aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="student-email"
                name="email"
                required
                autocomplete="email"
                placeholder="ejemplo@correo.com"
                aria-describedby="email-help"
                class="w-full text-base sm:text-lg px-5 py-4 rounded-xl bg-slate-900 border-2 border-slate-700 text-white placeholder-slate-300 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20 transition-all"
              />
              <p id="email-help" class="text-xs sm:text-sm text-slate-300 mt-2">
                Le enviaremos un enlace seguro directo a este correo.
              </p>
            </div>

            <div>
              <label for="student-name" class="block text-base font-semibold text-white mb-2">
                Su Nombre <span class="text-slate-300 text-xs font-normal">(opcional)</span>
              </label>
              <input
                type="text"
                id="student-name"
                name="nombre"
                autocomplete="name"
                placeholder="Ej. María o Carlos"
                class="w-full text-base sm:text-lg px-5 py-4 rounded-xl bg-slate-900 border-2 border-slate-700 text-white placeholder-slate-300 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20 transition-all"
              />
            </div>

            <div id="form-feedback" class="hidden" role="status" aria-live="polite"></div>

            <button
              type="submit"
              id="submit-btn"
              class="w-full min-h-[54px] py-4 px-6 rounded-xl bg-emerald-400 hover:bg-emerald-300 text-slate-950 font-black text-base sm:text-lg shadow-lg shadow-emerald-500/30 transition-transform transform hover:scale-[1.01] flex items-center justify-center gap-3 cursor-pointer"
            >
              <span>📩</span>
              <span id="submit-text">Enviar mi Enlace de Acceso en 1 Clic</span>
            </button>
          </form>

          <div class="mt-8 pt-6 border-t border-slate-800 text-center">
            <p class="text-sm text-slate-300 mb-3">
              ¿Tiene dificultades para entrar o no recuerda su correo?
            </p>
            <a
              href="https://wa.me/573000000000?text=Hola%20tutor%20de%20LDDIGITALCO,%20necesito%20ayuda%20para%20ingresar%20a%20mi%20Aula%20Digital."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-300 hover:bg-amber-500/20 text-sm font-semibold transition-colors"
            >
              <span>💬</span>
              <span>Pedir Asistencia a un Tutor por WhatsApp</span>
            </a>
          </div>

        </div>
      </section>
    )}

    {student && (
      <div>
        <!-- User Welcome & Stats Card -->
        <div class="glass-card rounded-2xl p-6 border border-slate-800 mb-8 flex flex-wrap items-center justify-between gap-6">
          <div>
            <div class="flex items-center gap-3 mb-1">
              <span class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-cyan-950 text-cyan-400 border border-cyan-500/30">
                {student.rol === 'admin' ? 'Administrador' : student.rol === 'tutor' ? 'Tutor' : 'Estudiante Activo'}
              </span>
              <span class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-950 text-emerald-400 border border-emerald-500/30">
                {student.nivel_acceso === 'inscripcion_completa' ? 'Inscripción Completa' : 'Ruta Abierta'}
              </span>
            </div>
            <h1 class="text-2xl font-bold font-tech text-white">
              Bienvenido, {student.nombre}
            </h1>
            <p class="text-xs text-slate-300 mt-0.5">
              Ruta actual: <span class="text-emerald-400 font-semibold">{route?.titulo || 'Ciberseguridad y Prevención de Estafas en WhatsApp'}</span>
            </p>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <div class="w-full sm:w-64">
              <div class="flex justify-between text-xs font-semibold mb-1.5">
                <span class="text-slate-300">Progreso Formativo</span>
                <span id="progress-text" class="text-emerald-400 font-bold">{progressStats.porcentaje}% Completado ({progressStats.completadas} de {progressStats.total})</span>
              </div>
              <div class="w-full h-2.5 bg-slate-800 rounded-full overflow-hidden p-0.5 border border-slate-700" role="progressbar" aria-valuenow={progressStats.porcentaje} aria-valuemin="0" aria-valuemax="100">
                <div id="progress-bar" class="h-full bg-gradient-to-r from-cyan-400 to-emerald-400 rounded-full transition-all duration-500" style={`width: ${progressStats.porcentaje}%;`}></div>
              </div>
            </div>

            <form action="/api/auth/logout" method="POST">
              <button
                type="submit"
                id="btn-logout"
                class="min-h-[48px] min-w-[48px] px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-xs font-semibold flex items-center justify-center gap-1.5 cursor-pointer"
                title="Cerrar sesión segura"
              >
                <span>🚪</span> Salir
              </button>
            </form>
          </div>
        </div>

        <!-- Banner Empático de Conexión y Resiliencia Offline (ADR 0009 / WCAG AAA Senior) -->
        <div
          id="offline-status-banner"
          role="status"
          aria-live="polite"
          class="hidden mb-6 p-5 rounded-2xl border-2 transition-all duration-300"
        >
          <div class="flex items-start sm:items-center justify-between gap-4">
            <div class="flex items-start sm:items-center gap-4">
              <div id="offline-banner-icon" class="text-3xl shrink-0 p-2.5 rounded-xl bg-slate-900/60 border border-slate-700/50">
                💾
              </div>
              <div>
                <h4 id="offline-banner-title" class="font-bold text-base sm:text-lg mb-1 font-tech text-amber-300">
                  Tu avance está protegido en este dispositivo
                </h4>
                <p id="offline-banner-message" class="text-sm sm:text-base leading-relaxed text-slate-100">
                  Sin conexión a internet por el momento. ¡No te preocupes! Tu avance está a salvo en tu dispositivo y se guardará automáticamente cuando regrese la conexión.
                </p>
              </div>
            </div>
            <button
              id="banner-close"
              data-alias="offline-banner-close"
              type="button"
              class="min-h-[48px] min-w-[48px] flex items-center justify-center text-slate-300 hover:text-white p-2 rounded-lg text-lg transition-colors cursor-pointer shrink-0"
              aria-label="Cerrar aviso informativo"
            >
              ✕
            </button>
          </div>
        </div>

        <!-- Rutas de Aprendizaje Catalog Card Listing (ADR 0008 / Issue #6 & Spec) -->
        <section aria-labelledby="rutas-catalog-heading" class="mb-8">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h2 id="rutas-catalog-heading" class="text-xl sm:text-2xl font-bold font-tech text-white flex items-center gap-2">
                <span>🧭</span> Tus Rutas de Aprendizaje
              </h2>
              <p class="text-xs sm:text-sm text-slate-300 mt-1">
                Explore y seleccione su ruta formativa. Todas las microcápsulas están diseñadas paso a paso.
              </p>
            </div>
            {!isEnrolledFull && (
              <a
                href="https://wa.me/573000000000?text=Hola,%20quisiera%20solicitar%20la%20Inscripción%20Completa%20para%20desbloquear%20todas%20las%20rutas."
                target="_blank"
                rel="noopener noreferrer"
                class="hidden sm:inline-flex items-center gap-1.5 min-h-[48px] px-4 py-2 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold text-xs shadow-md transition-colors"
              >
                <span>⭐</span> Mejorar a Inscripción Completa
              </a>
            )}
          </div>

          <div class="grid md:grid-cols-2 gap-5">
            <!-- Ruta Abierta: Ciberseguridad y Prevención de Estafas en WhatsApp -->
            <div class={`glass-card rounded-2xl p-6 border-2 transition-all ${route?.slug === 'ciberseguridad-whatsapp' ? 'border-emerald-400 glow-green' : 'border-slate-800 hover:border-slate-700'}`}>
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-400 border border-emerald-500/30">
                  <span>🌿</span> Ruta Abierta (100% Accesible)
                </span>
                {route?.slug === 'ciberseguridad-whatsapp' ? (
                  <span class="text-xs font-bold text-emerald-400 flex items-center gap-1">
                    <span>●</span> Ruta Activa
                  </span>
                ) : (
                  <span class="text-xs text-slate-300">Disponible</span>
                )}
              </div>

              <h3 class="text-lg font-bold font-tech text-white mb-2">
                Ruta Abierta: Ciberseguridad y Prevención de Estafas en WhatsApp
              </h3>
              <p class="text-xs sm:text-sm text-slate-300 mb-4 leading-relaxed">
                Aprenda a blindar su WhatsApp contra engaños, configurar su teléfono cómodamente y comunicarse con su familia sin miedos.
              </p>

              <div class="flex items-center justify-between pt-3 border-t border-slate-800">
                <span class="text-xs font-semibold text-slate-300">
                  4 Microcápsulas • 10:50 min
                </span>
                <a
                  href="/alumnos?ruta=ciberseguridad-whatsapp"
                  class={`min-h-[48px] px-5 py-2.5 rounded-xl font-bold text-xs flex items-center justify-center gap-2 transition-all cursor-pointer ${
                    route?.slug === 'ciberseguridad-whatsapp'
                      ? 'bg-emerald-400 text-slate-950 shadow-md shadow-emerald-500/20'
                      : 'bg-slate-800 text-slate-200 hover:bg-slate-700 border border-slate-700'
                  }`}
                >
                  {route?.slug === 'ciberseguridad-whatsapp' ? 'Continuar Aprendiendo →' : 'Ver Esta Ruta →'}
                </a>
              </div>
            </div>

            <!-- Ruta Avanzada: Banca Móvil Segura y Trámites Digitales -->
            <div class={`glass-card rounded-2xl p-6 border-2 transition-all relative overflow-hidden ${
              isEnrolledFull
                ? (route?.slug === 'banca-movil-segura' ? 'border-cyan-400 glow-blue' : 'border-slate-800 hover:border-slate-700')
                : 'border-slate-800/80 bg-slate-950/40 opacity-95'
            }`}>
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider ${
                  isEnrolledFull
                    ? 'bg-cyan-950 text-cyan-400 border border-cyan-500/30'
                    : 'bg-amber-950 text-amber-300 border border-amber-500/40'
                }`}>
                  {isEnrolledFull ? (
                    <><span>🚀</span> Ruta Avanzada (Desbloqueada)</>
                  ) : (
                    <><span>🔒</span> Inscripción Completa</>
                  )}
                </span>
                {isEnrolledFull && route?.slug === 'banca-movil-segura' && (
                  <span class="text-xs font-bold text-cyan-400 flex items-center gap-1">
                    <span>●</span> Ruta Activa
                  </span>
                )}
              </div>

              <h3 class="text-lg font-bold font-tech text-white mb-2 flex items-center gap-2">
                {!isEnrolledFull && <span class="text-amber-400">🔒</span>}
                Ruta Avanzada: Banca Móvil Segura y Trámites Digitales
              </h3>
              <p class="text-xs sm:text-sm text-slate-300 mb-4 leading-relaxed">
                Aprenda a realizar pagos, consultar saldos y gestionar su dinero desde el celular con total seguridad y sin riesgos.
              </p>

              <div class="flex items-center justify-between pt-3 border-t border-slate-800">
                <span class="text-xs font-semibold text-slate-300">
                  3 Microcápsulas • 08:30 min
                </span>
                {isEnrolledFull ? (
                  <a
                    href="/alumnos?ruta=banca-movil-segura"
                    class={`min-h-[48px] px-5 py-2.5 rounded-xl font-bold text-xs flex items-center justify-center gap-2 transition-all cursor-pointer ${
                      route?.slug === 'banca-movil-segura'
                        ? 'bg-cyan-400 text-slate-950 shadow-md shadow-cyan-500/20'
                        : 'bg-slate-800 text-slate-200 hover:bg-slate-700 border border-slate-700'
                    }`}
                  >
                    {route?.slug === 'banca-movil-segura' ? 'Continuar Aprendiendo →' : 'Ver Esta Ruta →'}
                  </a>
                ) : (
                  <a
                    href="https://wa.me/573000000000?text=Hola,%20quisiera%20solicitar%20la%20Inscripción%20Completa%20para%20desbloquear%20la%20Ruta%20de%20Banca%20Móvil%20Segura."
                    target="_blank"
                    rel="noopener noreferrer"
                    class="min-h-[48px] px-5 py-2.5 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 font-bold text-xs flex items-center justify-center gap-1.5 transition-colors cursor-pointer"
                  >
                    <span>🔒</span> Desbloquear con Inscripción Completa
                  </a>
                )}
              </div>
            </div>
          </div>
        </section>

        <div class="grid lg:grid-cols-3 gap-8">
          
          <div class="lg:col-span-2 space-y-6">
            
            <div class="glass-card rounded-3xl border border-slate-700/80 shadow-2xl overflow-hidden">
              
              <!-- Reproductor Embebido de Video -->
              <div class="relative bg-slate-950 aspect-video flex flex-col items-center justify-center border-b border-slate-800 bg-gradient-to-b from-slate-900 via-slate-950 to-black">
                <iframe
                  id="youtube-iframe"
                  title={currentCapsule ? currentCapsule.titulo : 'Reproductor de Microcápsula'}
                  src={`https://www.youtube-nocookie.com/embed/${currentCapsule?.youtubeId || 'dQw4w9WgXcQ'}?enablejsapi=1&rel=0&modestbranding=1`}
                  class="w-full h-full border-0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>

              <!-- Metadatos de la Microcápsula -->
              <div class="p-6 bg-slate-900/90 border-b border-slate-800">
                <div class="flex flex-wrap items-center justify-between gap-3 mb-2">
                  <span class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-cyan-950 text-cyan-400 border border-cyan-500/30">
                    Microcápsula en Reproducción
                  </span>
                  <!-- Badge ¡Completado! Verde Neón -->
                  <span
                    id="completion-badge"
                    class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-400 glow-border-green transition-all ${currentCapsule && completedSlugs.includes(currentCapsule.slug) ? '' : 'hidden'}`}
                  >
                    <span>✓</span> <span>¡Completado!</span>
                  </span>
                </div>
                <h2 id="lesson-title" class="text-lg sm:text-2xl font-bold text-white font-tech">
                  {currentCapsule?.titulo}
                </h2>
                <p id="lesson-duration" class="text-xs sm:text-sm text-slate-300 mt-1">
                  Duración: {currentCapsule?.duracion} • Explicado paso a paso
                </p>
              </div>

              <!-- Controles del Reproductor (Senior-friendly, WCAG AAA) -->
              <div class="p-6 bg-slate-900/95 flex flex-wrap items-center justify-between gap-4">
                <div class="flex flex-wrap items-center gap-3">
                  <button
                    id="prev-lesson-btn"
                    type="button"
                    class="min-h-[48px] px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs sm:text-sm border border-slate-700 flex items-center gap-2 cursor-pointer transition-colors"
                  >
                    ← Microcápsula Anterior
                  </button>

                  <button
                    id="toggle-complete-btn"
                    type="button"
                    aria-pressed={currentCapsule && completedSlugs.includes(currentCapsule.slug) ? 'true' : 'false'}
                    class="min-h-[48px] px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600 font-semibold text-xs sm:text-sm flex items-center gap-2 cursor-pointer transition-colors"
                  >
                    <span id="toggle-complete-text">
                      {currentCapsule && completedSlugs.includes(currentCapsule.slug) ? '✓ Completada (clic para desmarcar)' : '○ Marcar como completada'}
                    </span>
                  </button>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                  <button
                    id="doubt-btn"
                    type="button"
                    class="min-h-[48px] px-5 py-3 rounded-xl bg-amber-500/20 text-amber-300 border border-amber-500/40 hover:bg-amber-500/30 font-semibold text-xs sm:text-sm flex items-center gap-1.5 cursor-pointer transition-colors"
                  >
                    <span>❓</span> Tengo una Duda
                  </button>

                  <button
                    id="next-lesson-btn"
                    type="button"
                    class="min-h-[48px] px-7 py-3 rounded-xl bg-emerald-400 hover:bg-emerald-300 text-slate-950 font-bold text-xs sm:text-sm shadow-md shadow-emerald-500/20 flex items-center gap-1.5 cursor-pointer transition-transform transform hover:scale-[1.02]"
                  >
                    <span id="next-lesson-text">Siguiente Microcápsula →</span>
                  </button>
                </div>
              </div>

            </div>

            <!-- Resumen Pedagógico -->
            <div class="glass-card rounded-2xl p-6 border border-slate-800">
              <h3 class="text-sm font-bold text-cyan-400 uppercase tracking-wider mb-2 font-tech">Resumen y Recomendaciones</h3>
              <p id="lesson-summary" class="text-slate-300 text-sm leading-relaxed">
                {currentCapsule?.resumen}
              </p>
            </div>

          </div>

          <div class="space-y-6">
            
            {isEnrolledFull ? (
              <div
                id="live-session-container"
