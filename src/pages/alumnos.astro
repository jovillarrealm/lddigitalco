---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Portal de Alumnos — LDDIGITALCO" activeNav="alumnos">
  <!-- LMS Main Area -->
  <main class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 flex-1">
    
    <!-- User Welcome & Stats Card -->
    <div class="glass-card rounded-2xl p-6 border border-slate-800 mb-8 flex flex-wrap items-center justify-between gap-6">
      <div>
        <span class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-cyan-950 text-cyan-400 border border-cyan-500/30">Alumno Activo</span>
        <h1 class="text-2xl font-bold font-tech text-white mt-1">Bienvenido a su Aula Digital</h1>
        <p class="text-xs text-slate-400 mt-0.5">Ruta actual: <span class="text-emerald-400 font-semibold">Ciberseguridad y Prevención de Estafas en WhatsApp</span></p>
      </div>

      <div class="w-full sm:w-72">
        <div class="flex justify-between text-xs font-semibold mb-1.5">
          <span class="text-slate-400">Progreso de la Ruta</span>
          <span id="progress-text" class="text-emerald-400 font-bold">50% Completado</span>
        </div>
        <div class="w-full h-2.5 bg-slate-800 rounded-full overflow-hidden p-0.5 border border-slate-700">
          <div id="progress-bar" class="h-full bg-gradient-to-r from-cyan-400 to-emerald-400 rounded-full transition-all duration-500" style="width: 50%;"></div>
        </div>
      </div>
    </div>

    <!-- Main Player & Curriculum Grid -->
    <div class="grid lg:grid-cols-3 gap-8">
      
      <!-- Video Capsule Player (Cols 1-2) -->
      <div class="lg:col-span-2 space-y-6">
        
        <div class="glass-card rounded-3xl overflow-hidden border border-slate-700/80 shadow-2xl">
          
          <!-- Screen Mockup -->
          <div class="relative bg-slate-950 aspect-video flex flex-col items-center justify-center p-6 text-center border-b border-slate-800 bg-gradient-to-b from-slate-900 via-slate-950 to-black">
            <div onclick="nextLesson()" class="w-20 h-20 rounded-full bg-cyan-500/20 border-2 border-cyan-400 flex items-center justify-center text-cyan-400 text-3xl cursor-pointer hover:scale-110 transition-transform shadow-lg shadow-cyan-500/30">
              ▶
            </div>
            <h2 id="lesson-title" class="text-lg sm:text-xl font-bold text-white mt-4 font-tech max-w-xl">
              Cápsula #3: Cómo identificar un mensaje o enlace de estafa en WhatsApp
            </h2>
            <p id="lesson-duration" class="text-xs text-slate-400 mt-1">Duración: 02:45 • Explicado paso a paso</p>

            <!-- Video Progress Simulation -->
            <div class="absolute bottom-4 left-6 right-6 flex items-center justify-between text-xs text-slate-400 font-mono">
              <span>01:15 / 02:45</span>
              <div class="flex-1 mx-4 h-1.5 bg-slate-800 rounded-full overflow-hidden">
                <div class="h-full bg-cyan-400 w-1/2"></div>
              </div>
              <span>🔊 100%</span>
            </div>
          </div>

          <!-- Large Navigation Buttons (Tailored for Seniors) -->
          <div class="p-6 bg-slate-900/90 flex flex-wrap items-center justify-between gap-4">
            <button onclick="prevLesson()" class="px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs sm:text-sm border border-slate-700 flex items-center gap-2">
              ← Lección Anterior
            </button>

            <div class="flex items-center gap-3">
              <button onclick="openWhatsApp('Hola tutor de LDDIGITALCO, estoy en la cápsula de WhatsApp y tengo una duda.')" class="px-5 py-3 rounded-xl bg-amber-500/20 text-amber-300 border border-amber-500/40 hover:bg-amber-500/30 font-semibold text-xs sm:text-sm flex items-center gap-1.5">
                <span>❓</span> Tengo una Duda
              </button>

              <button onclick="nextLesson()" class="px-7 py-3 rounded-xl bg-emerald-400 hover:bg-emerald-300 text-slate-950 font-bold text-xs sm:text-sm shadow-md shadow-emerald-500/20 flex items-center gap-1.5">
                <span>Siguiente Microcápsula</span> →
              </button>
            </div>
          </div>

        </div>

        <!-- Lesson Summary Card -->
        <div class="glass-card rounded-2xl p-6 border border-slate-800">
          <h3 class="text-sm font-bold text-cyan-400 uppercase tracking-wider mb-2 font-tech">Resumen y Recomendaciones</h3>
          <p id="lesson-summary" class="text-slate-300 text-sm leading-relaxed">
            Recuerde la regla de oro: <strong>Ningún banco o entidad solicita contraseñas por WhatsApp</strong>. Si un mensaje genera urgencia extrema, no abra el enlace y consulte primero con su tutor de LDDIGITALCO o un familiar de confianza.
          </p>
        </div>

      </div>

      <!-- Right Col: Live Zoom Access & Playlist -->
      <div class="space-y-6">
        
        <!-- Live Class 1-Click Card -->
        <div class="glass-card rounded-3xl p-6 border-2 border-emerald-400 glow-green bg-gradient-to-b from-[#0c241a] to-slate-900 shadow-xl">
          <div class="flex items-center justify-between mb-3">
            <span class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-400 text-slate-950">Clase Grupal en Vivo</span>
            <span class="text-xs text-emerald-400 font-mono font-bold">HOY 18:00</span>
          </div>

          <h3 class="text-lg font-bold text-white font-tech">Taller en Directo: Práctica de Celular</h3>
          <p class="text-slate-200 text-xs mt-1 mb-5">Conéctese con sus profesores para practicar juntos y resolver dudas en tiempo real.</p>

          <button onclick="alert('Abriendo Google Meet / Zoom de la clase en vivo... ¡Bienvenido!')" class="w-full py-4 rounded-xl bg-emerald-400 hover:bg-emerald-300 text-slate-950 font-black text-sm shadow-lg shadow-emerald-500/30 transition-transform transform hover:scale-[1.02] flex items-center justify-center gap-2">
            <span class="text-xl">📹</span>
            <span>Entrar a mi Clase en 1 Clic</span>
          </button>
        </div>

        <!-- Dynamic Curriculum Playlist -->
        <div class="glass-card rounded-2xl p-6 border border-slate-800">
          <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-4 font-tech">Cápsulas de la Ruta</h4>
          
          <div id="curriculum-list" class="space-y-2.5">
            <!-- Rendered dynamically by js/lms.js -->
          </div>
        </div>

      </div>

    </div>

  </main>

  <script is:inline src="/js/lms.js"></script>
</BaseLayout>
