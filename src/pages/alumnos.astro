  </main>

  <script is:inline>
    // Client-side handling for Magic Link submission
    const form = document.getElementById('magic-link-form');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const emailInput = document.getElementById('student-email');
        const nameInput = document.getElementById('student-name');
        const feedback = document.getElementById('form-feedback');
        const submitBtn = document.getElementById('submit-btn');
        const submitText = document.getElementById('submit-text');

        const email = emailInput?.value?.trim();
        const nombre = nameInput?.value?.trim();

        if (!email) {
          if (feedback) {
            feedback.className = 'p-4 rounded-xl bg-red-950/80 border border-red-500 text-red-200 text-sm font-medium';
            feedback.innerHTML = '⚠️ Por favor, escriba su correo electrónico.';
          }
          return;
        }

        // Estado de carga
        if (submitBtn) submitBtn.disabled = true;
        if (submitText) submitText.textContent = 'Enviando su enlace seguro...';
        if (feedback) {
          feedback.className = 'hidden';
          feedback.innerHTML = '';
        }

        try {
          const res = await fetch('/api/auth/magic-link', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, nombre }),
          });

          const data = await res.json();

          if (res.ok && data.success) {
            if (feedback) {
              feedback.className = 'p-5 rounded-2xl bg-emerald-950/80 border-2 border-emerald-400 text-emerald-200 text-sm leading-relaxed';
              feedback.innerHTML = `
                <div class="flex items-start gap-3">
                  <span class="text-2xl">✉️</span>
                  <div>
                    <strong class="text-white block text-base mb-1">¡Enlace de acceso enviado!</strong>
                    Hemos enviado un enlace seguro a <strong>${email}</strong>.<br>
                    Abra su correo y haga clic en el botón verde para entrar automáticamente a su Aula Digital.
                  </div>
                </div>
              `;
            }
            if (form) form.reset();
            if (submitText) submitText.textContent = 'Reenviar Enlace de Acceso';
          } else {
            if (feedback) {
              feedback.className = 'p-4 rounded-xl bg-amber-950/80 border border-amber-500 text-amber-200 text-sm font-medium';
              feedback.innerHTML = `⚠️ ${data.error || 'No se pudo enviar el enlace. Intente nuevamente.'}`;
            }
            if (submitText) submitText.textContent = 'Enviar mi Enlace de Acceso en 1 Clic';
          }
        } catch (err) {
          if (feedback) {
            feedback.className = 'p-4 rounded-xl bg-red-950/80 border border-red-500 text-red-200 text-sm font-medium';
            feedback.innerHTML = '⚠️ Ocurrió un error de conexión al enviar el enlace. Verifique su internet e intente nuevamente.';
          }
          if (submitText) submitText.textContent = 'Enviar mi Enlace de Acceso en 1 Clic';
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    }

    // Live session auto-refresh for active sessions (Issue #6)
    const liveContainer = document.getElementById('live-session-container');
    if (liveContainer) {
      async function refreshLiveSession() {
        try {
          const res = await fetch('/api/live-session');
          if (!res.ok) return;
          const data = await res.json();
          if (!data.success || !data.canAccess) return;

          const pill = document.getElementById('live-status-pill');
          const helpMsg = document.getElementById('live-session-help-msg');
          const joinBtn = document.getElementById('live-join-btn');

          if (data.status === 'active' && data.meetUrl) {
            if (pill) {
              pill.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-400 text-slate-950 animate-pulse';
              pill.textContent = '● En Vivo Ahora';
            }
            if (helpMsg) {
              helpMsg.className = 'text-emerald-300 text-xs text-center mt-2 font-medium';
              helpMsg.textContent = '¡La clase está activa en este momento! Haga clic para ingresar.';
            }
            if (joinBtn && joinBtn.tagName === 'BUTTON') {
              const a = document.createElement('a');
              a.id = 'live-join-btn';
              a.href = data.meetUrl;
              a.target = '_blank';
              a.rel = 'noopener noreferrer';
              a.className = 'w-full min-h-[48px] py-4 rounded-xl bg-emerald-400 hover:bg-emerald-300 text-slate-950 font-black text-sm shadow-lg shadow-emerald-500/30 transition-transform transform hover:scale-[1.02] flex items-center justify-center gap-2 cursor-pointer';
              a.innerHTML = '<span class="text-xl">📹</span><span>Entrar a mi Clase en 1 Clic</span>';
              joinBtn.parentNode?.replaceChild(a, joinBtn);
            }
          } else if (data.status === 'upcoming') {
            if (pill) {
              pill.textContent = data.startsInDisplay || (data.startsInMinutes > 0 && data.startsInMinutes <= 60 ? `Inicia en ${data.startsInMinutes} min` : data.formattedTime || 'Próximamente');
            }
          }
        } catch {
          // Ignore network errors in polling
        }
      }

      setInterval(refreshLiveSession, 30000);
    }
  </script>


  <script is:inline src="/js/offline-sync.js"></script>
  <script is:inline src="/js/lms-player.js"></script>
</BaseLayout>
