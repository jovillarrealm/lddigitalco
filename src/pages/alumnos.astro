          aria-labelledby="duda-upgrade-title"
          aria-describedby="duda-upgrade-desc"
          class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4"
        >
          <div
            class="relative w-full max-w-lg rounded-3xl bg-slate-900 border-2 border-amber-500/60 shadow-2xl p-6 sm:p-8 text-white"
          >
            <!-- Botón Cerrar (Accesible min 48x48) -->
            <button
              id="duda-upgrade-close-btn"
              type="button"
              aria-label="Cerrar ventana informativa"
              class="absolute top-5 right-5 min-h-[48px] min-w-[48px] flex items-center justify-center text-slate-300 hover:text-white text-2xl rounded-xl hover:bg-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-amber-400 cursor-pointer"
            >
